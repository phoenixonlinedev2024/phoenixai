# ─── JARVIS OpenClaw Configuration ───────────────────────────────────────────

# Anthropic Claude API (REQUIRED)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model (default: claude-opus-4-7 — most capable)
CLAUDE_MODEL=claude-opus-4-7
MAX_TOKENS=8192

# ─── Voice ────────────────────────────────────────────────────────────────────

# Enable/disable voice output (true/false)
VOICE_ENABLED=true

# Wake word for voice activation (default: jarvis)
WAKE_WORD=jarvis

# TTS engine: pyttsx3 (offline/free) or elevenlabs (cloud/premium)
TTS_ENGINE=pyttsx3

# ElevenLabs (only needed if TTS_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Daemon / API ─────────────────────────────────────────────────────────────

DAEMON_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000

# ─── Self-Learning ────────────────────────────────────────────────────────────

LEARNING_ENABLED=true

# How often JARVIS reflects and learns from sessions (in hours)
REFLECTION_INTERVAL_HOURS=6
