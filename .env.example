# ─── JARVIS OpenClaw Configuration v4 ────────────────────────────────────────
# Copy to .env and fill in your values.
# Only ANTHROPIC_API_KEY is required — everything else is optional.

# ── Anthropic Claude (REQUIRED) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-7
MAX_TOKENS=8192

# ── Multi-provider fallback chain ─────────────────────────────────────────────
# Comma-separated order: anthropic, openrouter, openai_compat, ollama
PROVIDER_ORDER=anthropic
# OpenRouter (100+ free models — no API key needed for free tier)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
# Generic OpenAI-compatible endpoint (LM Studio, vLLM, Together, etc.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-3.5-turbo
# Ollama (local LLM, fully offline — https://ollama.ai)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Personality ───────────────────────────────────────────────────────────────
# Options: default | professional | casual | terse | verbose
DEFAULT_PROFILE=default

# ── Voice ─────────────────────────────────────────────────────────────────────
VOICE_ENABLED=true
WAKE_WORD=jarvis
# STT engine: whisper (offline, best quality) | google (online, no install)
STT_ENGINE=whisper
# Whisper model size: tiny (fastest) | base | small | medium | large (most accurate)
WHISPER_MODEL=base
# TTS engine: pyttsx3 (offline, instant) | piper (offline, neural) | elevenlabs (cloud)
TTS_ENGINE=pyttsx3
# Piper (only if TTS_ENGINE=piper) — run: jarvis install-piper
PIPER_BINARY=piper
PIPER_MODEL=./piper/en_US-lessac-medium.onnx
# ElevenLabs (only if TTS_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Daemon / API ──────────────────────────────────────────────────────────────
DAEMON_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
# Proactive monitor check interval (seconds)
MONITOR_INTERVAL=300

# ── Security ──────────────────────────────────────────────────────────────────
# Set to true to require X-Api-Key header on all API requests
SECURITY_ENABLED=false
# Max requests per minute per API key (sliding window)
RATE_LIMIT=120

# ── Self-learning ─────────────────────────────────────────────────────────────
LEARNING_ENABLED=true
REFLECTION_INTERVAL_HOURS=6
# Confidence threshold (0.0–1.0): below this JARVIS retries its answer
CONFIDENCE_THRESHOLD=0.6
# A/B test competing approaches (uses extra API calls)
AB_TESTING_ENABLED=false
# Collect conversation trajectories for fine-tuning dataset export
TRAJECTORY_COLLECTION=true

# ── Self-improvement ──────────────────────────────────────────────────────────
# Hours between automated benchmark + gap-fill cycles (0 to disable)
SELF_IMPROVE_INTERVAL_HOURS=12

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Backend for code execution: local | docker | ssh | modal
SANDBOX_BACKEND=local
DOCKER_IMAGE=python:3.11-slim
# SSH sandbox (optional — fill in to use a remote machine)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_PASSWORD=

# ── Object storage (S3/R2/MinIO) ─────────────────────────────────────────────
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Leave blank for AWS S3; set to R2/MinIO endpoint for alternatives
S3_ENDPOINT_URL=

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# ── Hugging Face (image generation) ──────────────────────────────────────────
HF_API_TOKEN=

# ── Platform bots (all optional) ─────────────────────────────────────────────

# Telegram — get token from @BotFather
TELEGRAM_TOKEN=

# Discord — create bot at https://discord.com/developers/applications
DISCORD_TOKEN=

# Slack — create app at https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Signal — install signal-cli: https://github.com/AsamK/signal-cli
SIGNAL_PHONE_NUMBER=
SIGNAL_CLI_PATH=signal-cli

# IRC
IRC_SERVER=
IRC_PORT=6667
IRC_NICK=JARVIS
# Comma-separated list of channels to join
IRC_CHANNELS=#jarvis

# Matrix / Element — get access token from Element → Settings → Help
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=@jarvis:matrix.org
MATRIX_ACCESS_TOKEN=

# Mattermost (self-hosted) — create bot account and generate token
MATTERMOST_URL=http://localhost:8065
MATTERMOST_TOKEN=
MATTERMOST_BOT_USER_ID=
MATTERMOST_BOT_NAME=jarvis

# WhatsApp — Option A: Twilio sandbox (instant, free trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp — Option B: Meta Cloud API (production)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=jarvis_verify
