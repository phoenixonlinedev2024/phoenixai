# ─── JARVIS OpenClaw Configuration v2 ────────────────────────────────────────

# ── Anthropic Claude (REQUIRED) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-7
MAX_TOKENS=8192

# ── Personality ───────────────────────────────────────────────────────────────
# Options: default | professional | casual | terse | verbose
DEFAULT_PROFILE=default

# ── Voice ─────────────────────────────────────────────────────────────────────
VOICE_ENABLED=true
WAKE_WORD=jarvis

# STT engine: whisper (offline, best quality) | google (online, no install)
STT_ENGINE=whisper
# Whisper model size: tiny (fastest) | base | small | medium | large (best)
WHISPER_MODEL=base

# TTS engine: pyttsx3 (offline, instant) | piper (offline, neural) | elevenlabs (cloud)
TTS_ENGINE=pyttsx3
# Piper (only if TTS_ENGINE=piper) — run: jarvis install-piper
PIPER_BINARY=piper
PIPER_MODEL=./piper/en_US-lessac-medium.onnx
# ElevenLabs (only if TTS_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Daemon / API ──────────────────────────────────────────────────────────────
DAEMON_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
# Proactive monitor check interval in seconds
MONITOR_INTERVAL=300

# ── Self-Learning ─────────────────────────────────────────────────────────────
LEARNING_ENABLED=true
REFLECTION_INTERVAL_HOURS=6
# Confidence threshold (0.0-1.0) — below this, JARVIS retries its answer
CONFIDENCE_THRESHOLD=0.6
# A/B test competing approaches (experimental, uses extra API calls)
AB_TESTING_ENABLED=false

# ── GitHub Integration (optional) ─────────────────────────────────────────────
GITHUB_TOKEN=

# ── Email (optional) ──────────────────────────────────────────────────────────
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# ── Telegram Bot (optional) ───────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_TOKEN=

# ── Discord Bot (optional) ────────────────────────────────────────────────────
# Create bot at https://discord.com/developers/applications
DISCORD_TOKEN=

# ── Ollama local LLM fallback (optional) ──────────────────────────────────────
# Install Ollama: https://ollama.ai
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
